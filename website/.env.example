# ---- Public site ----
NEXT_PUBLIC_SITE_URL=https://www.nammaphysiocentre.in

# ---- Booking storage (Neon Postgres) ----
# Create a Neon project, copy the pooled connection string, then run: npm run db:migrate
DATABASE_URL=

# ---- Clinic notifications (Resend) ----
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Namma Physio Website <bookings@your-verified-domain.in>"
NOTIFY_TO_EMAIL=

# ---- Clinic admin (booking requests dashboard at /admin) ----
# Generate with: npm run admin:hash -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# 32+ random characters, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# ---- Google reviews (Places API (New)) ----
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ---- Optional Google Calendar integration ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32-byte hex key used to encrypt the stored refresh token: `openssl rand -hex 32`
CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_ID=primary

# ---- Optional Billing Software Inquiry Sync ----
# By default, the local billing software pairs using ADMIN_PASSWORD_HASH via /api/inquiries/pair.
# Optionally set a static 20+ character Bearer token and/or local webhook URL:
INQUIRY_SYNC_TOKEN=
BILLING_WEBHOOK_URL=
