# ---- Public site ----
NEXT_PUBLIC_SITE_URL=https://www.nammaphysiocentre.in
NEXT_PUBLIC_DEVELOPER_URL=https://infinity-web-apps.vercel.app
NEXT_PUBLIC_SHOW_EXPANDED_DEV_CTA=false

# ---- Booking storage (Neon Postgres) ----
# Create a Neon project, copy the pooled connection string, then run: npm run db:migrate
DATABASE_URL=

# ---- Clinic Gmail OAuth 2.0 Appointment Automation ----
# Clinic owner authorizes Smilewithsidhu2008@gmail.com from /admin (minimal gmail.send scope).
CLINIC_GMAIL_ADDRESS=Smilewithsidhu2008@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 64-hex-character AES-256-GCM key (`openssl rand -hex 32`) used to encrypt OAuth refresh tokens at rest:
OAUTH_TOKEN_ENCRYPTION_KEY=
# Set to "true" or "false" to control immediate acknowledgement email on appointment submission (default true when Gmail is verified):
SEND_PATIENT_ACKNOWLEDGEMENT=true
# Default appointment slot duration in minutes (used for overlap & calendar availability checks):
DEFAULT_APPOINTMENT_MINUTES=45

# ---- Optional fallback clinic alert (Resend) ----
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Namma Physiotherapy Centre <bookings@your-verified-domain.in>"
NOTIFY_TO_EMAIL=

# ---- Clinic admin (booking requests & integrations dashboard at /admin) ----
# Generate with: npm run admin:hash -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# 32+ random characters (`openssl rand -hex 32`), also signs HMAC state cookies
ADMIN_SESSION_SECRET=

# ---- Dynamic Google Reviews (GBP OAuth 2.0 + Places API (New) fallback) ----
# Preferred: Authorize verified Google Business Profile at /admin -> Connect Google Reviews
GOOGLE_GBP_LOCATION_NAME=
# Fallback: Google Places API (New) — provides live rating, review count, and up to 5 Google-selected reviews
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Optional secret header (`Authorization: Bearer <CRON_SECRET>`) for scheduled /api/cron/reviews-sync
CRON_SECRET=

# ---- Optional Google Calendar integration ----
# Shares GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET and OAUTH_TOKEN_ENCRYPTION_KEY (or CALENDAR_TOKEN_ENCRYPTION_KEY)
CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_ID=primary

# ---- Optional Billing Software Inquiry Sync ----
# Local billing software pairs using ADMIN_PASSWORD_HASH via /api/inquiries/pair.
INQUIRY_SYNC_TOKEN=
BILLING_WEBHOOK_URL=
