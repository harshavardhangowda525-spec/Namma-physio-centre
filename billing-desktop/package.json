{
  "name": "namma-physio-billing",
  "productName": "Namma Physio Billing",
  "version": "1.0.0",
  "private": true,
  "description": "Private, offline billing and clinic-management software for Namma Physio Centre. Runs locally on 127.0.0.1 only.",
  "author": "Infinity Web & Apps",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,ui \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "cross-env NPB_DEV_UI_PORT=5173 tsx watch server/standalone.ts",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run typecheck && npm run build:ui && npm run build:main",
    "start": "node dist-electron/standalone.js",
    "electron": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win nsis",
    "prestart": "node -e \"require('fs').existsSync('dist-electron/standalone.js')||(console.error('\\nRun: npm run build  (then npm start)\\n'),process.exit(1))\""
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "12.4.1",
    "express": "^5.3.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
